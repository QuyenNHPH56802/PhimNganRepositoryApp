# Translator — environment template
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─── Core ──────────────────────────────────────────────────────────────────
# Generate session secret: python -c "import secrets; print(secrets.token_hex(32))"
TRANSLATOR_SESSION_SECRET=           # REQUIRED — 64-char hex string, generate with command above
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/translator
TEMPORAL_HOST=localhost:7233
STORAGE_BACKEND=local              # local | s3
LOCAL_STORAGE_DIR=./var/assets
PUBLIC_BASE_URL=http://localhost:8000

# ─── Translation providers (translation providers read these env vars) ──
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── ASR / alignment / diarization ──────────────────────────────────────
HF_TOKEN=                          # required by pyannote
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
WHISPER_MODEL=large-v3
WAV2VEC2_MODEL=facebook/wav2vec2-base-960h

# ─── TTS / voice cloning ────────────────────────────────────────────────
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
GOOGLE_APPLICATION_CREDENTIALS=    # path to GCP service-account JSON
DASHSCOPE_API_KEY=               # Alibaba Cloud / DashScope: https://dashscope.console.aliyun.com
DASHSCOPE_BASE_URL=              # defaults to https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_STREAMING=             # set to 1/true to enable SSE streaming mode (lower TTFB, slightly higher total latency)

# ─── S3 / GCS / R2 ──────────────────────────────────────────────────────
S3_BUCKET=translator-prod
S3_REGION=ap-southeast-1
S3_ENDPOINT=                       # leave blank for AWS, set for R2/MinIO
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_TTL_SECONDS=3600

# ─── Kubernetes (worker scheduling) ─────────────────────────────────────
KUBE_CONFIG=                       # path to kubeconfig
KUBE_NAMESPACE=translator
KUBE_GPU_NODE_LABEL=nvidia.com/gpu.present

# ─── Feature flags (optional ENV overrides) ────────────────────────────
# Naming: FLAG_<NAME> with dots/dashes → underscores
FLAG_WORKFLOW_SUBTITLE_ALIGNMENT_V2=true
FLAG_PIPELINE_VOICE_CLONE=false

# ─── Observability ──────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=                        # Server-side Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=             # Client-side Sentry DSN (same value, public prefix)
# Build identity surfaced by /api/healthz and rendered by the EnvBadge.
# Set in CI; defaults to "development" / "" locally.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GIT_SHA=
NEXT_PUBLIC_BUILD_ID=
