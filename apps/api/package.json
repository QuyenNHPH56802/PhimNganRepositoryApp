{
  "name": "@translator/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uvicorn translator_api.main:app --host 0.0.0.0 --port 8000 --reload",
    "db:migrate": "alembic -c infra/migrations/alembic.ini upgrade head",
    "db:revision": "alembic -c infra/migrations/alembic.ini revision --autogenerate -m",
    "lint": "ruff check python",
    "test": "pytest"
  },
  "dependencies": {
    "fastapi>=0.111.0",
    "uvicorn[standard]>=0.30.1",
    "pydantic>=2.8.2",
    "pydantic-settings>=2.4.0",
    "sqlalchemy>=2.0.31",
    "psycopg[binary]>=3.2.1",
    "alembic>=1.13.2",
    "boto3>=1.34.150",
    "temporalio>=1.7.0",
    "python-multipart>=0.0.9",
    "httpx>=0.27.0"
  },
  "devDependencies": {
    "ruff": "0.6.2",
    "pytest": "8.3.2",
    "pytest-asyncio": "0.23.8"
  }
}