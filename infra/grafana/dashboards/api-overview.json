{
  "title": "Translator — API Overview",
  "uid": "translator-api",
  "tags": ["translator", "api"],
  "timezone": "browser",
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate (req/s)",
      "targets": [
        {
          "expr": "sum(rate(translator_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50/p95/p99 latency (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(translator_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(translator_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(translator_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5xx)",
      "targets": [
        {
          "expr": "sum(rate(translator_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(translator_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.005 }, { "color": "red", "value": 0.02 }] } } },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active projects",
      "targets": [
        { "expr": "translator_active_projects", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Shedder state",
      "targets": [
        { "expr": "translator_shedder_state", "refId": "A" }
      ],
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 }
    }
  ]
}