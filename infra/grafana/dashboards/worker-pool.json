{
  "title": "Translator — Worker Pool",
  "uid": "translator-worker",
  "tags": ["translator", "worker"],
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth",
      "targets": [
        { "expr": "translator_queue_depth", "legendFormat": "{{task_queue}}", "refId": "A" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "heatmap",
      "title": "Activity duration heatmap",
      "targets": [
        { "expr": "sum by (le)(rate(translator_activity_duration_seconds_bucket[5m]))", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A" }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "targets": [
        { "expr": "sum(rate(translator_cache_hit_total[10m])) / (sum(rate(translator_cache_hit_total[10m])) + sum(rate(translator_cache_miss_total[10m])))", "legendFormat": "hit ratio", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Activity failures (5m)",
      "targets": [
        { "expr": "sum(rate(translator_activity_calls_total{status=\"failed\"}[5m]))", "refId": "A" }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 }
    }
  ]
}